# {{ ansible_managed }}
upstream odoo_{{ odoo_nginx_domain | regex_replace('[^A-Za-z0-9]', '_') }} {
    server 127.0.0.1:{{ odoo_nginx_upstream_port }};
}
upstream odoo_ws_{{ odoo_nginx_domain | regex_replace('[^A-Za-z0-9]', '_') }} {
    server 127.0.0.1:{{ odoo_nginx_websocket_port }};
}
{% set up = 'odoo_' ~ (odoo_nginx_domain | regex_replace('[^A-Za-z0-9]', '_')) %}
{% set ws = 'odoo_ws_' ~ (odoo_nginx_domain | regex_replace('[^A-Za-z0-9]', '_')) %}
{% set tls = _tls | string | trim | bool %}
{% for proxy in odoo_nginx_trusted_proxies %}
set_real_ip_from {{ proxy }};
{% endfor %}
{% if odoo_nginx_trusted_proxies %}
real_ip_header X-Forwarded-For;
{% endif %}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ odoo_nginx_domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
{% if tls %}
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # "listen ... http2" rather than "http2 on": Ubuntu ships nginx 1.18 (22.04) and 1.24 (24.04)
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ odoo_nginx_domain }};

    ssl_certificate {{ _cert | trim }};
    ssl_certificate_key {{ _key | trim }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}

    client_max_body_size {{ odoo_nginx_client_max_body_size }};
    proxy_read_timeout 720s;
    proxy_connect_timeout 720s;
    proxy_send_timeout 720s;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto {{ 'https' if tls else '$scheme' }};
    proxy_set_header X-Real-IP $remote_addr;

    location /websocket {
        proxy_pass http://{{ ws }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location / {
        proxy_pass http://{{ up }};
        proxy_redirect off;
    }

    gzip on;
    gzip_types text/css text/plain application/json application/javascript text/xml application/xml;
}
