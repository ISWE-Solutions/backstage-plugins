# {{ ansible_managed }}
RUNBOT_URL={{ runbot_builder_url }}
RUNBOT_TOKEN={{ runbot_builder_token }}
GITHUB_TOKEN={{ runbot_builder_github_token }}
RUNBOT_HOST={{ runbot_builder_name }}
RUNBOT_WORKERS={{ runbot_builder_workers }}
RUNBOT_WORKDIR={{ runbot_builder_workdir }}
RUNBOT_MEMORY={{ runbot_builder_memory }}
RUNBOT_CPUS={{ runbot_builder_cpus }}
PGHOST=127.0.0.1
PGPORT=5432
PGUSER={{ runbot_builder_user }}
PGPASSWORD={{ _runbot_pg_password }}
RUNBOT_EXECUTORS={{ runbot_builder_executors | join(',') }}
{% if 'proxmox' in runbot_builder_executors %}
{% set px = runbot_builder_proxmox %}
PROXMOX_URL={{ px.url }}
PROXMOX_TOKEN_ID={{ px.token_id }}
PROXMOX_TOKEN_SECRET={{ px.token_secret }}
PROXMOX_CA_FILE={{ '/etc/odoo-runbot-builder-proxmox-ca.pem' if px.ca_file else '' }}
PROXMOX_VERIFY_TLS={{ '1' if px.verify_tls | bool else '0' }}
PROXMOX_NODE={{ px.node }}
PROXMOX_TEMPLATES={{ px.templates | to_json }}
PROXMOX_VMIDS={{ px.first_vmid }}
PROXMOX_IPS={{ px.ips | join(',') }}
PROXMOX_PREFIX={{ px.prefix }}
PROXMOX_GATEWAY={{ px.gateway }}
PROXMOX_BRIDGE={{ px.bridge }}
PROXMOX_POOL={{ px.pool }}
PROXMOX_SSH_KEY={{ runbot_builder_workdir }}/.ssh/id_ed25519
{% endif %}
