{
  "name": "@iswesolutions/odoo-proxmox-runbot",
  "version": "0.1.0",
  "description": "Backstage frontend plugin for managing Odoo instances, Runbot builds, Ansible playbooks and Proxmox LXC containers",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "odoo",
    "pluginPackages": [
      "@iswesolutions/odoo-proxmox-runbot"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "start": "backstage-cli package start",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/core-components": "^0.18.10",
    "@backstage/core-plugin-api": "^1.12.6",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.3.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.2",
    "@types/react": "^18.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISWE-Solutions/backstage-plugins.git",
    "directory": "plugins/odoo-proxmox-runbot"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "odoo",
    "runbot",
    "proxmox",
    "ansible"
  ],
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/ISWE-Solutions/backstage-plugins/tree/main/plugins/odoo-proxmox-runbot#readme",
  "bugs": {
    "url": "https://github.com/ISWE-Solutions/backstage-plugins/issues"
  }
}
