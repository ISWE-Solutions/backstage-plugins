{
  "name": "@iswesolutions/odoo-proxmox-runbot",
  "version": "0.3.0",
  "description": "Backstage frontend plugin for Odoo: a live Runbot (CI for Odoo repositories, with the odoo-runbot backend), an instance form with code sources, shared PostgreSQL and odoo.conf validation, and the Ansible playbooks for Proxmox, LXD or Docker and runbot builders",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "odoo",
    "pluginPackages": [
      "@iswesolutions/odoo-proxmox-runbot",
      "@iswesolutions/plugin-odoo-runbot-backend",
      "@iswesolutions/plugin-odoo-runbot-common"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "start": "backstage-cli package start",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.7.0",
    "@backstage/core-components": "^0.18.10",
    "@backstage/core-plugin-api": "^1.12.6",
    "@backstage/errors": "^1.3.1",
    "@backstage/plugin-catalog-react": "^3.0.0",
    "@iswesolutions/plugin-odoo-runbot-common": "^0.1.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/lab": "^4.0.0-alpha.61"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.3.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.2",
    "@backstage/test-utils": "^1.7.18",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISWE-Solutions/backstage-plugins.git",
    "directory": "plugins/odoo-proxmox-runbot"
  },
  "keywords": [
    "ansible",
    "backstage",
    "backstage-plugin",
    "docker",
    "lxd",
    "odoo",
    "proxmox",
    "runbot"
  ],
  "files": [
    "dist",
    "ansible"
  ],
  "homepage": "https://github.com/ISWE-Solutions/backstage-plugins/tree/main/plugins/odoo-proxmox-runbot#readme",
  "bugs": {
    "url": "https://github.com/ISWE-Solutions/backstage-plugins/issues"
  }
}
