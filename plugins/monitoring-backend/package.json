{
  "name": "@iswesolutions/plugin-monitoring-backend",
  "version": "0.1.0",
  "description": "Backend for @iswesolutions/plugin-monitoring: shared settings (cost rates, electricity tariff) for its Settings tab, editable with the monitoring.settings.update permission",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "monitoring",
    "pluginPackages": [
      "@iswesolutions/plugin-monitoring",
      "@iswesolutions/plugin-monitoring-backend"
    ]
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.9.1",
    "@backstage/errors": "^1.3.1",
    "@backstage/plugin-permission-common": "^0.9.9",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.2",
    "@types/express": "^4.17.21",
    "better-sqlite3": "^12.0.0",
    "knex": "^3.1.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISWE-Solutions/backstage-plugins.git",
    "directory": "plugins/monitoring-backend"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "monitoring",
    "settings"
  ],
  "homepage": "https://github.com/ISWE-Solutions/backstage-plugins/tree/main/plugins/monitoring-backend#readme",
  "bugs": {
    "url": "https://github.com/ISWE-Solutions/backstage-plugins/issues"
  }
}
