# Shared base vhost for {{ host_proxy_base_domain }}. Per-instance location
# blocks live in {{ host_proxy_upstream_dir }}/<instance>.conf and are
# pulled in by the include directive inside the TLS server{} below.
# Managed by Ansible (roles/host_proxy). Safe to recreate.
server {
    listen 80;
    listen [::]:80;
    server_name {{ host_proxy_base_domain }};

    # ACME http-01 challenges are always served from the local webroot so
    # certbot can issue / renew the cert without --nginx having to touch
    # this file. This location must stay above any catch-all return so
    # the challenge files take precedence over the redirect.
    location ^~ /.well-known/acme-challenge/ {
        root {{ host_proxy_webroot }};
        default_type "text/plain";
        try_files $uri =404;
    }

{% if host_proxy_cert_present | default(false) %}
    location / {
        return 301 https://$server_name$request_uri;
    }
{% else %}
    # Bootstrap mode: the TLS cert for {{ host_proxy_base_domain }} has
    # not been issued yet, so we can't enable the 443 server{} block
    # (nginx would refuse to start with a missing ssl_certificate file).
    # Serve a placeholder on HTTP and let certbot --webroot complete the
    # ACME challenge; the next render will flip cert_present=true and
    # bring the SSL server up.
    location / {
        default_type text/plain;
        return 200 "bootstrap: awaiting TLS certificate for {{ host_proxy_base_domain }}\n";
    }
{% endif %}
}

{% if host_proxy_cert_present | default(false) %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ host_proxy_base_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ host_proxy_base_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ host_proxy_base_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    client_max_body_size 100M;

    access_log /var/log/nginx/{{ host_proxy_base_domain }}_access.log;
    error_log  /var/log/nginx/{{ host_proxy_base_domain }}_error.log;

    # Per-instance location blocks (one file per DHIS2 instance).
    include {{ host_proxy_upstream_dir }}/*.conf;
}
{% endif %}
