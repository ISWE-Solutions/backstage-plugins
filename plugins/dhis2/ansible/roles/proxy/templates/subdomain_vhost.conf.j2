# Vhost for {{ host_proxy_base_domain }} → upstream dhis2_{{ host_proxy_vmid }}
# Managed by Ansible (roles/host_proxy). Safe to recreate.
server {
    listen 80;
    listen [::]:80;
    server_name {{ host_proxy_base_domain }};

    # ACME http-01 challenges. Kept above any catch-all return so certbot
    # --webroot can complete the challenge before / after the cert exists.
    location ^~ /.well-known/acme-challenge/ {
        root {{ host_proxy_webroot }};
        default_type "text/plain";
        try_files $uri =404;
    }

{% if host_proxy_cert_present | default(false) %}
    location / {
        return 301 https://$server_name$request_uri;
    }
{% else %}
    # Bootstrap mode: TLS cert not issued yet. Serve a placeholder over
    # HTTP so nginx stays valid; the SSL server{} below is rendered on
    # the next pass once certbot has minted the cert.
    location / {
        default_type text/plain;
        return 200 "bootstrap: awaiting TLS certificate for {{ host_proxy_base_domain }}\n";
    }
{% endif %}
}

{% if host_proxy_cert_present | default(false) %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ host_proxy_base_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ host_proxy_base_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ host_proxy_base_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    client_max_body_size 100M;

    access_log /var/log/nginx/{{ host_proxy_base_domain }}_access.log;
    error_log  /var/log/nginx/{{ host_proxy_base_domain }}_error.log;

    location / {
        proxy_pass http://dhis2_{{ host_proxy_vmid }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 300s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_buffering off;
    }

    location /dhis-web-commons-stream {
        proxy_pass http://dhis2_{{ host_proxy_vmid }}/dhis-web-commons-stream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }
}
{% endif %}
