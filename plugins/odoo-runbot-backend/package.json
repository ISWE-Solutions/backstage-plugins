{
  "name": "@iswesolutions/plugin-odoo-runbot-backend",
  "version": "0.1.0",
  "description": "ISWE Runbot for Backstage: continuous integration for Odoo repositories after odoo/runbot (projects, triggers, bundles, batches, builds, GitHub statuses), with a builder agent",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "odoo-runbot",
    "pluginPackages": [
      "@iswesolutions/odoo-proxmox-runbot",
      "@iswesolutions/plugin-odoo-runbot-backend",
      "@iswesolutions/plugin-odoo-runbot-common"
    ]
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.9.1",
    "@backstage/errors": "^1.3.1",
    "@backstage/plugin-permission-common": "^0.9.9",
    "@iswesolutions/plugin-odoo-runbot-common": "^0.1.0",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.2",
    "@types/express": "^4.17.21",
    "better-sqlite3": "^12.0.0",
    "knex": "^3.1.0"
  },
  "configSchema": "config.d.ts",
  "files": [
    "dist",
    "config.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISWE-Solutions/backstage-plugins.git",
    "directory": "plugins/odoo-runbot-backend"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "odoo",
    "runbot",
    "ci"
  ]
}
