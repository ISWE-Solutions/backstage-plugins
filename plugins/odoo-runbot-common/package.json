{
  "name": "@iswesolutions/plugin-odoo-runbot-common",
  "version": "0.1.0",
  "description": "Shared types, permissions and rules (bundles, versions, build results) of the ISWE Runbot for Backstage",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "backstage": {
    "role": "common-library",
    "pluginId": "odoo-runbot",
    "pluginPackages": [
      "@iswesolutions/odoo-proxmox-runbot",
      "@iswesolutions/plugin-odoo-runbot-backend",
      "@iswesolutions/plugin-odoo-runbot-common"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/plugin-permission-common": "^0.9.9"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISWE-Solutions/backstage-plugins.git",
    "directory": "plugins/odoo-runbot-common"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "odoo",
    "runbot",
    "ci"
  ]
}
