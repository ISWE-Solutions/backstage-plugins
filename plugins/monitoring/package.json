{
  "name": "@iswesolutions/plugin-monitoring",
  "version": "0.1.0",
  "description": "Backstage frontend plugin with a monitoring overview: service health, Prometheus metrics, Grafana dashboards, security alerts and cost insights (sample data)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "monitoring",
    "pluginPackages": [
      "@iswesolutions/plugin-monitoring"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "start": "backstage-cli package start",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/core-components": "^0.18.10",
    "@backstage/core-plugin-api": "^1.12.6",
    "@backstage/theme": "^0.7.3",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/lab": "^4.0.0-alpha.61",
    "recharts": "^2.5.0"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.3.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.2",
    "@types/react": "^18.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISWE-Solutions/backstage-plugins.git",
    "directory": "plugins/monitoring"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "monitoring",
    "prometheus",
    "grafana",
    "observability"
  ],
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/ISWE-Solutions/backstage-plugins/tree/main/plugins/monitoring#readme",
  "bugs": {
    "url": "https://github.com/ISWE-Solutions/backstage-plugins/issues"
  }
}
